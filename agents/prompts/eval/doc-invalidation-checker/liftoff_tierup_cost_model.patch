+  //   epilogue teardown; charging the full entry cost would over-tier
+  //   trampoline-style tail-call dispatchers.
   static constexpr int kTierUpCostForCheck = 20;
   static constexpr int kTierUpCostForFunctionEntry = 1000;
+  static constexpr int kTierUpCostForTailCall = 425;

   struct ElseState {
     explicit ElseState(Zone* zone) : label(zone), state(zone) {}
@@ -3620,7 +3625,7 @@ class LiftoffCompiler {
